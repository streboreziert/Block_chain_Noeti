# Noetis — local / deploy env (copy to .env and fill in; never commit real values)

# Hub / site
PUBLIC_URL=http://127.0.0.1:5052
PUBLIC_HOST=127.0.0.1
SITE_USER_ADMIN_PASSWORD=
SITE_AUTH_ADMIN_KEY=

# Deploy (python/deploy.sh)
DEPLOY_REMOTE=root@YOUR_SERVER_IP
DEPLOY_REMOTE_DIR=/data/sites/noeticompute

# Federation
FEDERATION_PEERS=
BOOTSTRAP_PEERS=https://noeticompute.com
PRIMARY_REMOTE=root@YOUR_SERVER_IP
PEER_URL_DIRECT=http://127.0.0.1:5055
PEER_PUBLIC_URL=http://127.0.0.1:5055

# Network catalog / remote chat (optional)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
GOLEM_CHAT_API_KEY=
GOLEM_CHAT_BASE_URL=
GOLEM_CHAT_MODEL=qwen2.5:1.5b

# Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
